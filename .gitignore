# Global AI Missions — root .gitignore (delivery-engineer)
# Never commit secrets, dependencies, build outputs or caches (conventions.md §5).

# --- Secrets and local environment -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Python / backend -------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / frontend --------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/
coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Playwright -------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Logs and OS / IDE files ------------------------------------------------
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.sw?
*.suo

# --- Claude Code local settings (per-developer) -----------------------------
.claude/settings.local.json

# --- Official assessment brief (kept locally, not in the repo) ---------------
Evaluacion_Tecnica_Global_AI .pdf
