{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-ai-missions.local/contracts/items.schema.json",
  "title": "Mission items (content/missions/<mission>/items.json)",
  "description": "The assessment items of one mission. Frozen at G0 (tech-lead). Structure only: the blueprint (4/2/2/2 types, skills, CEFR spread), unique option ids and normalized, de-duplicated accepted answers are checked by the engine validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "items"],
  "properties": {
    "mission_id": { "$ref": "#/$defs/mission_id" },
    "items": {
      "description": "Ordered by position in the mission (q01 first). Array order is the item position.",
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "mission_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "item_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "Stable external id, e.g. q01. Referenced by checkpoint nodes in mission.json."
    },
    "option_id": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,8}$",
      "description": "Stable option id, e.g. a, b, c, d. Unique within its item (checked by the validator)."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Plain text. Line breaks as \\n. No Markdown, no HTML."
    },
    "item_type": {
      "enum": ["multiple_choice", "fill_blank", "comprehension", "vocabulary"]
    },
    "skill": {
      "enum": ["grammar", "vocabulary", "reading", "listening", "speaking"]
    },
    "cefr": {
      "enum": ["PRE_A1", "A1", "A2", "B1", "B2", "C1"]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/option_id" },
        "text": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 160 }] }
      }
    },
    "audio_stimulus": {
      "description": "Listening: played in the browser with speechSynthesis. The script reaches the client (documented trade-off); it is never shown as text before answering, except in the PD-014 fallback.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "speaker", "audio_script", "rate"],
      "properties": {
        "kind": { "const": "audio" },
        "speaker": {
          "type": ["string", "null"],
          "maxLength": 40,
          "description": "Who speaks, e.g. \"Station announcer\"."
        },
        "audio_script": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 600 }] },
        "rate": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.0,
          "description": "speechSynthesis rate: about 0.85 for A1-A2, 1.0 for B1-B2."
        },
        "text": { "type": "null" }
      }
    },
    "text_stimulus": {
      "description": "Something the student reads inside the scene. kind tells the frontend how to style it: dialogue (a spoken line), sign (a short sign or label), message (a phone message), notice (a station notice, ticket conditions), timetable (rows separated by \\n).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "speaker", "text"],
      "properties": {
        "kind": { "enum": ["dialogue", "sign", "message", "notice", "timetable"] },
        "speaker": {
          "type": ["string", "null"],
          "maxLength": 40,
          "description": "Who says or wrote it, or the source label (e.g. \"Guard\", \"From: Sam\", \"Station notice\")."
        },
        "text": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 1200 }] }
      }
    },
    "choice_answer_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct_option_id"],
      "properties": {
        "correct_option_id": { "$ref": "#/$defs/option_id" }
      }
    },
    "fill_blank_answer_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": {
        "accepted": {
          "description": "Every accepted answer (include contractions). Normalized and de-duplicated at seed time. The FIRST one is the answer the report displays.",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 80 }] }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "skill",
        "cefr",
        "prompt",
        "stimulus",
        "options",
        "answer_key",
        "explanation",
        "hint"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/item_id" },
        "type": { "$ref": "#/$defs/item_type" },
        "skill": { "$ref": "#/$defs/skill" },
        "cefr": { "$ref": "#/$defs/cefr" },
        "prompt": {
          "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 300 }],
          "description": "The decision the student makes. For fill_blank it contains exactly one gap written as three underscores: ___"
        },
        "stimulus": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/audio_stimulus" },
            { "$ref": "#/$defs/text_stimulus" }
          ]
        },
        "options": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/option" }
            }
          ]
        },
        "answer_key": {
          "oneOf": [
            { "$ref": "#/$defs/choice_answer_key" },
            { "$ref": "#/$defs/fill_blank_answer_key" }
          ]
        },
        "explanation": {
          "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 400 }],
          "description": "1-2 learner-friendly sentences. Shown only on the report of a submitted attempt."
        },
        "hint": {
          "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 200 }],
          "description": "A strategy, never the answer. Maya says it when the planner decides HINT."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "fill_blank" } } },
          "then": {
            "properties": {
              "options": { "type": "null" },
              "answer_key": { "$ref": "#/$defs/fill_blank_answer_key" },
              "prompt": { "pattern": "^[^_]*___[^_]*$" }
            }
          },
          "else": {
            "properties": {
              "options": { "type": "array" },
              "answer_key": { "$ref": "#/$defs/choice_answer_key" }
            }
          }
        }
      ]
    }
  }
}
