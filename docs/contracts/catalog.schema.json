{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-ai-missions.local/contracts/catalog.schema.json",
  "title": "Missions catalog (content/catalog.json)",
  "description": "The English World catalog. Frozen at G0 (tech-lead). Unlock rules are deterministic data (PD-008); the LLM never unlocks anything. Unique ids and rule references are checked by backend/scripts/validate_content.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "missions"],
  "properties": {
    "catalog_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump when the catalog changes; the seed upserts missions by id."
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/mission" }
    }
  },
  "$defs": {
    "mission_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "cefr": {
      "enum": ["PRE_A1", "A1", "A2", "B1", "B2", "C1"]
    },
    "skill": {
      "enum": ["grammar", "vocabulary", "reading", "listening", "speaking"]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "unlock_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "hint"],
      "properties": {
        "kind": { "enum": ["always", "mission_submitted", "level_reached"] },
        "mission_id": {
          "$ref": "#/$defs/mission_id",
          "description": "mission_submitted only: met when the student has at least one submitted attempt of this mission."
        },
        "min_level": {
          "$ref": "#/$defs/cefr",
          "description": "level_reached only: met when any submitted Mission Report suggests this level or higher (by CEFR rank)."
        },
        "hint": {
          "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 160 }],
          "description": "Human-readable rule shown on a locked card, e.g. \"Opens after your first Mission Report on The Last Train.\""
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "always" } } },
          "then": {
            "not": { "anyOf": [{ "required": ["mission_id"] }, { "required": ["min_level"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "mission_submitted" } } },
          "then": { "required": ["mission_id"], "not": { "required": ["min_level"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "level_reached" } } },
          "then": { "required": ["min_level"], "not": { "required": ["mission_id"] } }
        }
      ]
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "world_zone",
        "skill_focus",
        "cefr_range",
        "playable",
        "unlock_rule",
        "teaser",
        "sort_order"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/mission_id" },
        "title": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 80 }] },
        "world_zone": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "skill_focus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skill" }
        },
        "cefr_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "$ref": "#/$defs/cefr" },
            "max": { "$ref": "#/$defs/cefr" }
          }
        },
        "playable": {
          "type": "boolean",
          "description": "Only playable missions have content under content/missions/<id>/. Non-playable missions whose rule is met show as in_preparation (PD-007)."
        },
        "unlock_rule": { "$ref": "#/$defs/unlock_rule" },
        "teaser": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 200 }] },
        "sort_order": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
