# Global AI Missions — environment variables (SHARED_CONTEXT §10, CHANGE_REQUESTS F-07).
#
#   cp .env.example .env
#
# These defaults work locally as they are: PostgreSQL from docker-compose.yml, the mock
# coach (no API key needed) and demo mode on. Read by backend/app/core/config.py (the only
# reader of environment variables) and by docker compose for ${...} interpolation.
# Never commit .env. Every value below is for local development only.

# --- Persistence --------------------------------------------------------------
# SQLAlchemy URL with the psycopg 3 driver (must start with postgresql+psycopg://).
# Points at the compose database, published on host port 5433 (see docker-compose.yml).
# Hosted providers often give postgresql://...; rewrite the scheme to postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://gam:gam@127.0.0.1:5433/gam

# Host port for the compose PostgreSQL (default 5433). If you change it, change DATABASE_URL too.
# POSTGRES_HOST_PORT=5433

# --- App container (docker compose `api` service and Render) --------------------
# `docker compose up -d --build` publishes the app on this host port (default 8000). Inside the
# container compose sets DATABASE_URL to the internal network (db:5432), overriding the one above.
# API_HOST_PORT=8000
# uvicorn honours X-Forwarded-For/-Proto only from these proxy addresses (default: loopback).
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Auth ---------------------------------------------------------------------
# HS256 signing key for the session JWT. At least 32 characters or the app refuses to boot.
# DEV-ONLY value: generate a real one for any deploy, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-global-ai-missions-local-secret-0001

# Session lifetime in minutes (optional, default 60).
# JWT_TTL_MINUTES=60

# Secure flag on the gam_session cookie. false for local http; set true on any https deploy.
COOKIE_SECURE=false

# --- AI coach (Maya's post-mission feedback) -----------------------------------
# mock      = deterministic feedback, no network, no key (default; the app works fully with it)
# anthropic = Claude through the official SDK; needs ANTHROPIC_API_KEY and ANTHROPIC_MODEL.
# openai_compatible = any OpenAI-compatible chat-completions API (Groq, xAI Grok, ...); needs
#             the four OPENAI_COMPAT_* variables below (a missing one -> the mock, logged).
# Any provider failure or timeout falls back to the mock (feedback_source.status = "fallback").
COACH_PROVIDER=mock

# Only when COACH_PROVIDER=anthropic. Leave commented out otherwise (an empty value is not "unset").
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Only when COACH_PROVIDER=openai_compatible. Base URL without /chat/completions; https only
# (http is accepted for localhost). There is no default model: model ids change, so check the
# provider's model list. OPENAI_COMPAT_LABEL is the report footer ("Written by Maya using ...");
# optional, derived from the host when unset ("Groq", "Grok (xAI)", otherwise "AI coach").
# Check the live call with: cd backend && uv run python scripts/coach_smoke.py
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_LABEL=
#
# Example, Groq (free tier; key from https://console.groq.com/keys):
# COACH_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=<your Groq key>
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
# OPENAI_COMPAT_LABEL=Groq · Llama
#
# Example, xAI Grok (key from https://console.x.ai):
# COACH_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=https://api.x.ai/v1
# OPENAI_COMPAT_API_KEY=<your xAI key>
# OPENAI_COMPAT_MODEL=grok-4-fast-non-reasoning
# OPENAI_COMPAT_LABEL=Grok (xAI)

# --- Demo ---------------------------------------------------------------------
# true: GET /api/config lists the demo accounts and password on the check-in screen
# (and enables /simulate, stretch). The app's secure default is false; local runs and the
# evaluation demo turn it on.
DEMO_MODE=true
